salesforce.WorkflowRule Account_account_rule@vs {
  fullName = "Account.account rule"
  actions = [
    {
      name = salesforce.WorkflowAlert.instance.Account_send_email@vu
      type = "Alert"
    },
  ]
  active = false
  formula = "test_text_account__c  <> \"8\""
  triggerType = "onCreateOrTriggeringUpdate"
  _parent = [
    salesforce.Account,
  ]
  _generated_dependencies = [
    {
      reference = salesforce.Account.field.test_text_account__c
    },
  ]
  _alias = "Account.account rule"
}
