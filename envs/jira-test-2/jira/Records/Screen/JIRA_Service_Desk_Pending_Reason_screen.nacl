jira.Screen JIRA_Service_Desk_Pending_Reason_screen@s {
  name = "JIRA Service Desk Pending Reason screen"
  description = "Screen to specify the pending reason when transitioning to the Pending status"
  tabs = {
    General = {
      name = "General"
      fields = [
        jira.Field.instance.Linked_Issues__array@suu,
        jira.Field.instance.test_field__textfield__c,
      ]
      position = 0
    }
  }
}
