jira.Filter Filter_for_TP_board@s {
  name = "Filter for TP board"
  owner = {
    id = "61d44bf59ee70a00685fa6b6"
    displayName = "Testing salto"
  }
  jql = "${ jira.Field.instance.Project__project } = ${ jira.Project.instance.Test_Project@s.key } ORDER BY ${ jira.Field.instance.Rank__gh_lexo_rank__c@uubbuu.name } ASC"
  sharePermissions = [
    {
      type = "project"
      project = {
        id = jira.Project.instance.Test_Project@s
      }
    },
  ]
}
